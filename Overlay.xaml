<Window x:Class="Notch.Overlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Notch"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Width="1000" Height="260">
  <Window.Resources>
    <!-- round, see-through buttons that light up a little when hovered -->
    <Style x:Key="Ctl" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="Transparent" CornerRadius="13">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- solid little keys for the calculator / language chips -->
    <Style x:Key="Key" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="#18FFFFFF" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
  <!-- pill on top, hover menu drops down underneath it -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

    <!-- the black notch/island. its width grows out from the middle -->
    <Border x:Name="Shape" HorizontalAlignment="Center" ClipToBounds="True" AllowDrop="True"
            Background="#000000" Width="190" Height="40" CornerRadius="0,0,22,22"
            RenderTransformOrigin="0.5,0">
      <Border.RenderTransform>
        <!-- lets you grab and stretch it, then it springs back when you let go -->
        <ScaleTransform x:Name="Stretch" ScaleX="1" ScaleY="1"/>
      </Border.RenderTransform>

      <Grid>
        <!-- optional blurred album art behind everything (off by default) -->
        <Border x:Name="Frost" CornerRadius="{Binding CornerRadius, ElementName=Shape}" Visibility="Collapsed">
          <Border.Background><ImageBrush x:Name="FrostBrush" Stretch="UniformToFill"/></Border.Background>
          <Border.Effect><BlurEffect Radius="26"/></Border.Effect>
        </Border>
        <Border x:Name="FrostShade" CornerRadius="{Binding CornerRadius, ElementName=Shape}"
                Background="#AA000000" Visibility="Collapsed"/>

        <!-- art, title, visualizer, privacy dots -->
        <Grid x:Name="Content" Margin="12,0" ClipToBounds="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="ArtHost" Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                  ClipToBounds="True" Visibility="Collapsed">
            <Image x:Name="Art" Stretch="UniformToFill"/>
          </Border>

          <!-- shown instead of the art during a notification / copied pop -->
          <TextBlock x:Name="NoteIcon" Grid.Column="0" FontFamily="Segoe MDL2 Assets" Foreground="White"
                     FontSize="17" VerticalAlignment="Center" Visibility="Collapsed" Text="&#xE7E7;"/>

          <!-- file preview shown for a moment when you drop a file on the notch -->
          <Border x:Name="NoteImageHost" Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                  ClipToBounds="True" Visibility="Collapsed">
            <Image x:Name="NoteImage" Stretch="UniformToFill"/>
          </Border>

          <!-- download ring: sits where the album art goes while a download runs -->
          <Grid x:Name="DlRing" Grid.Column="0" Width="30" Height="30" Visibility="Collapsed">
            <Ellipse Stroke="#26FFFFFF" StrokeThickness="3" Width="26" Height="26"/>
            <Path x:Name="DlArc" Stroke="#3DD6C4" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 13,2 A 11,11 0 0 1 24,13" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><RotateTransform x:Name="DlSpin" Angle="0"/></Path.RenderTransform>
            </Path>
            <!-- swapped in for the spinner for a beat when a download finishes -->
            <Ellipse x:Name="DlDoneFill" Width="26" Height="26" Fill="#3DD6C4" Visibility="Collapsed"/>
            <TextBlock x:Name="DlCheck" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="Black"
                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>

          <!-- recording / screen-capture live pill: a pulsing red dot where the art goes -->
          <Grid x:Name="RecBadge" Grid.Column="0" Width="30" Height="30" Visibility="Collapsed">
            <Ellipse x:Name="RecDot" Width="15" Height="15" Fill="#FF3B30"/>
          </Grid>

          <StackPanel x:Name="NotePanel" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0" Visibility="Collapsed">
            <TextBlock x:Name="NoteTitle" Foreground="White" FontFamily="Segoe UI" FontSize="11.5"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="NoteBody" Foreground="#9AA0A6" FontFamily="Segoe UI" FontSize="9.5"
                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
          </StackPanel>

          <!-- song title and artist (hidden in ios layout) -->
          <StackPanel x:Name="Info" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0" Visibility="Collapsed">
            <TextBlock x:Name="TitleText" Foreground="White" FontFamily="Segoe UI" FontSize="11.5"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ArtistText" Foreground="#9AA0A6" FontFamily="Segoe UI" FontSize="9.5"
                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- dots for mic, camera, screen share -->
            <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,6,0" Visibility="Collapsed">
              <Ellipse x:Name="MicDot" Width="7" Height="7" Margin="2,0" Fill="#FF9E1B" Visibility="Collapsed"/>
              <Ellipse x:Name="CamDot" Width="7" Height="7" Margin="2,0" Fill="#4ADE80" Visibility="Collapsed"/>
              <Ellipse x:Name="ScreenDot" Width="7" Height="7" Margin="2,0" Fill="#4DA3FF" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel x:Name="BarHost" Orientation="Horizontal" VerticalAlignment="Center"
                        Height="24" Visibility="Collapsed"/>
            <!-- alternative visualizer: a 9x9 grid of dots that expand with the audio -->
            <UniformGrid x:Name="DotHost" Rows="9" Columns="9" VerticalAlignment="Center" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>

        <!-- weather-reactive particles (rain / snow) drawn over the pill, off by default -->
        <Canvas x:Name="WeatherLayer" IsHitTestVisible="False"/>
      </Grid>
    </Border>

    <!-- hover menu: drops down under the pill, tabs on top, active panel below -->
    <Border x:Name="DropPanel" HorizontalAlignment="Center" Margin="0,6,0,0"
            Background="#000000" CornerRadius="16" Padding="10,8" Visibility="Collapsed"
            RenderTransformOrigin="0.5,0">
      <Border.RenderTransform>
        <ScaleTransform x:Name="Drop" ScaleX="1" ScaleY="0"/>
      </Border.RenderTransform>
      <StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
          <Button x:Name="TabMedia" Style="{StaticResource Ctl}" Content="&#xE768;" Margin="3,0"/>
          <Button x:Name="TabTimer" Style="{StaticResource Ctl}" Content="&#xE916;" Margin="3,0"/>
          <Button x:Name="TabStats" Style="{StaticResource Ctl}" Content="&#xEC4A;" Margin="3,0"/>
          <Button x:Name="TabShelf" Style="{StaticResource Ctl}" Content="&#xE723;" Margin="3,0"/>
          <Button x:Name="TabClip"  Style="{StaticResource Ctl}" Content="&#xE8C8;" Margin="3,0"/>
          <Button x:Name="TabApps"  Style="{StaticResource Ctl}" Content="&#xE71D;" Margin="3,0"/>
          <Button x:Name="TabCalc"  Style="{StaticResource Ctl}" Content="&#xE1D0;" Margin="3,0"/>
          <Button x:Name="TabTrans" Style="{StaticResource Ctl}" Content="&#xF2B7;" Margin="3,0"/>
          <Button x:Name="TabNet"   Style="{StaticResource Ctl}" Content="&#xE704;" Margin="3,0"/>
        </StackPanel>

        <Grid HorizontalAlignment="Center">
          <!-- media: prev / play-pause / next -->
          <StackPanel x:Name="MediaPanel" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PrevBtn" Style="{StaticResource Ctl}" Content="&#xE892;"/>
            <Button x:Name="PlayBtn" Style="{StaticResource Ctl}" Content="&#xE768;" Margin="10,0"/>
            <Button x:Name="NextBtn" Style="{StaticResource Ctl}" Content="&#xE893;"/>
          </StackPanel>

          <!-- timer: minus / time / plus / start-pause / reset -->
          <StackPanel x:Name="TimerPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <Button x:Name="TMinus" Style="{StaticResource Ctl}" FontFamily="Segoe UI" FontSize="16" Content="−"/>
            <TextBlock x:Name="TimerText" Foreground="White" FontFamily="Consolas" FontSize="14"
                       VerticalAlignment="Center" Margin="4,0" MinWidth="46" TextAlignment="Center" Text="05:00"/>
            <Button x:Name="TPlus" Style="{StaticResource Ctl}" FontFamily="Segoe UI" FontSize="16" Content="+"/>
            <Button x:Name="TStart" Style="{StaticResource Ctl}" Content="&#xE768;" Margin="6,0,0,0"/>
            <Button x:Name="TReset" Style="{StaticResource Ctl}" Content="&#xE72C;"/>
          </StackPanel>

          <!-- system stats: cpu, gpu and ram right now -->
          <StackPanel x:Name="StatsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="StatsText" Foreground="White" FontFamily="Segoe UI" FontSize="12"
                       VerticalAlignment="Center" Text="CPU --   GPU --   RAM --"/>
          </StackPanel>

          <!-- file shelf: drop files here to hold them, drag them back out later -->
          <Border x:Name="ShelfPanel" AllowDrop="True" Background="#14FFFFFF" CornerRadius="8"
                  Padding="6" MinWidth="150" MinHeight="42" Visibility="Collapsed">
            <StackPanel x:Name="ShelfItems" Orientation="Horizontal" VerticalAlignment="Center"/>
          </Border>

          <!-- clipboard history: recent copies, click one to copy it again -->
          <StackPanel x:Name="ClipItems" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"/>

          <!-- pinned apps: click to launch, right-click to remove, + to add -->
          <StackPanel x:Name="AppItems" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"/>

          <!-- calculator: tap the keys, = to evaluate. built in code so it stays compact -->
          <StackPanel x:Name="CalcPanel" Visibility="Collapsed"/>

          <!-- translator: translates whatever you last copied, tap a language -->
          <StackPanel x:Name="TransPanel" Width="290" Visibility="Collapsed">
            <TextBlock x:Name="TransSrc" Foreground="#9AA0A6" FontFamily="Segoe UI" FontSize="10.5"
                       TextWrapping="Wrap" MaxHeight="28" TextTrimming="CharacterEllipsis"/>
            <StackPanel x:Name="TransLangs" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6"/>
            <TextBlock x:Name="TransResult" Foreground="White" FontFamily="Segoe UI" FontSize="13.5"
                       TextWrapping="Wrap" MaxHeight="66"/>
          </StackPanel>

          <!-- network speed: down / up right now, with a little history strip -->
          <StackPanel x:Name="NetPanel" Visibility="Collapsed">
            <TextBlock x:Name="NetText" Foreground="White" FontFamily="Segoe UI" FontSize="14"
                       HorizontalAlignment="Center" Text="&#x2193; --   &#x2191; --"/>
            <StackPanel x:Name="NetBars" Orientation="Horizontal" Height="22"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- "device connected" card: drops down with a spinning 3D model -->
    <Border x:Name="DeviceCard" HorizontalAlignment="Center" Margin="0,6,0,0"
            Background="#000000" CornerRadius="16" Padding="10,8" Visibility="Collapsed"
            RenderTransformOrigin="0.5,0">
      <Border.RenderTransform>
        <ScaleTransform x:Name="DevScale" ScaleX="1" ScaleY="0"/>
      </Border.RenderTransform>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Viewport3D x:Name="Stage" Width="64" Height="64">
          <Viewport3D.Camera>
            <PerspectiveCamera Position="0,0,4.2" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="45"/>
          </Viewport3D.Camera>
          <ModelVisual3D>
            <ModelVisual3D.Content>
              <Model3DGroup>
                <AmbientLight Color="#8C8C8C"/>
                <DirectionalLight Color="#FFFFFF" Direction="-0.3,-0.5,-1"/>
                <DirectionalLight Color="#5A5A5A" Direction="0.4,0.4,1"/>
              </Model3DGroup>
            </ModelVisual3D.Content>
          </ModelVisual3D>
          <ModelVisual3D x:Name="DevModel">
            <ModelVisual3D.Transform>
              <RotateTransform3D>
                <RotateTransform3D.Rotation>
                  <AxisAngleRotation3D x:Name="DevSpin" Axis="0,1,0" Angle="0"/>
                </RotateTransform3D.Rotation>
              </RotateTransform3D>
            </ModelVisual3D.Transform>
          </ModelVisual3D>
        </Viewport3D>
        <StackPanel VerticalAlignment="Center" Margin="10,0,6,0">
          <TextBlock x:Name="DevTitle" Foreground="White" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"/>
          <TextBlock x:Name="DevSub" Foreground="#9AA0A6" FontFamily="Segoe UI" FontSize="10" Margin="0,1,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- "hey siri" mini live activity: a small orb + status that drops out of the notch -->
    <Border x:Name="SiriCard" HorizontalAlignment="Center" Margin="0,6,0,0"
            Background="#000000" CornerRadius="16" Padding="12,9" Visibility="Collapsed"
            RenderTransformOrigin="0.5,0">
      <Border.RenderTransform>
        <ScaleTransform x:Name="SiriScale" ScaleX="1" ScaleY="0"/>
      </Border.RenderTransform>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <local:SiriOrb x:Name="OrbCtl" Width="42" Height="42"/>
        <TextBlock x:Name="SiriStatus" Foreground="#E6FFFFFF" FontFamily="Segoe UI" FontSize="13.5"
                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,4,0"/>
      </StackPanel>
    </Border>

    <!-- airdrop-style "file landed" card: thumbnail springs in, with open / show buttons -->
    <Border x:Name="DropCard" HorizontalAlignment="Center" Margin="0,6,0,0"
            Background="#000000" CornerRadius="16" Padding="12,10" Visibility="Collapsed"
            RenderTransformOrigin="0.5,0">
      <Border.RenderTransform>
        <ScaleTransform x:Name="DropCardScale" ScaleX="1" ScaleY="0"/>
      </Border.RenderTransform>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="46" Height="46" CornerRadius="10" ClipToBounds="True" Background="#1AFFFFFF"
                RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform>
            <ScaleTransform x:Name="DropThumbScale" ScaleX="1" ScaleY="1"/>
          </Border.RenderTransform>
          <Image x:Name="DropThumb" Stretch="UniformToFill"/>
        </Border>
        <StackPanel VerticalAlignment="Center" Margin="12,0,4,0" MaxWidth="184">
          <TextBlock Text="Received" Foreground="#9AA0A6" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold"/>
          <TextBlock x:Name="DropName" Foreground="White" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
          <TextBlock x:Name="DropSub" Foreground="#9AA0A6" FontFamily="Segoe UI" FontSize="10" Margin="0,1,0,0"/>
        </StackPanel>
        <Button x:Name="DropOpen" Style="{StaticResource Ctl}" Content="&#xE8E5;" ToolTip="Open" Margin="6,0,0,0"/>
        <Button x:Name="DropShow" Style="{StaticResource Ctl}" Content="&#xE838;" ToolTip="Show in folder" Margin="2,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- apple-music-style live activity: the notch itself expands into this while music plays -->
    <Border x:Name="MediaCard" HorizontalAlignment="Center" Margin="0"
            Background="#000000" CornerRadius="0,0,22,22" Padding="16,14" Visibility="Collapsed"
            RenderTransformOrigin="0.5,0">
      <Border.RenderTransform>
        <ScaleTransform x:Name="MedScale" ScaleX="1" ScaleY="0"/>
      </Border.RenderTransform>
      <StackPanel Width="340">
        <!-- art + title/artist + a little playing equalizer -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="58" Height="58" CornerRadius="12" ClipToBounds="True">
            <Image x:Name="MArt" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
            <TextBlock x:Name="MTitle" Foreground="White" FontFamily="Segoe UI" FontSize="15"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="MArtist" Foreground="#9AA0A6" FontFamily="Segoe UI" FontSize="12"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel x:Name="MEq" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                      Height="18" Margin="4,0,2,0"/>
        </Grid>

        <!-- scrubber: elapsed / draggable bar / total -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="MTimeCur" Grid.Column="0" Text="0:00" Foreground="#9AA0A6"
                     FontFamily="Segoe UI" FontSize="10.5" VerticalAlignment="Center"/>
          <Grid x:Name="MScrub" Grid.Column="1" Height="16" Margin="10,0,10,0" Background="#01000000" Cursor="Hand">
            <Border Height="4" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
            <Border x:Name="MFill" Height="4" CornerRadius="2" Background="White"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
            <Ellipse x:Name="MThumb" Width="11" Height="11" Fill="White"
                     HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="MTimeTot" Grid.Column="2" Text="0:00" Foreground="#9AA0A6"
                     FontFamily="Segoe UI" FontSize="10.5" VerticalAlignment="Center"/>
        </Grid>

        <!-- shuffle / prev / play-pause / next / repeat -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
          <Button x:Name="MShuffle" Style="{StaticResource Ctl}" Content="&#xE8B1;" FontSize="15" Margin="10,0"/>
          <Button x:Name="MPrev" Style="{StaticResource Ctl}" Content="&#xE892;" FontSize="18" Margin="10,0"/>
          <Button x:Name="MPlay" Style="{StaticResource Ctl}" Content="&#xE768;" FontSize="24" Width="40" Height="40" Margin="12,0"/>
          <Button x:Name="MNext" Style="{StaticResource Ctl}" Content="&#xE893;" FontSize="18" Margin="10,0"/>
          <Button x:Name="MRepeat" Style="{StaticResource Ctl}" Content="&#xE8EE;" FontSize="15" Margin="10,0"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
    <!-- confetti bursts on big moments (off by default) -->
    <Canvas x:Name="ConfettiLayer" IsHitTestVisible="False"/>
  </Grid>
</Window>
