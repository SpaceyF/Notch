<UserControl x:Class="Notch.SiriOrb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="44" Height="44">
  <Grid RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <TransformGroup>
        <!-- grows with your voice -->
        <ScaleTransform x:Name="OrbReact" ScaleX="1" ScaleY="1"/>
        <!-- quick pop when a command lands -->
        <ScaleTransform x:Name="OrbScale" ScaleX="1" ScaleY="1"/>
      </TransformGroup>
    </Grid.RenderTransform>
    <!-- the little dark ball -->
    <Ellipse>
      <Ellipse.Fill>
        <RadialGradientBrush GradientOrigin="0.42,0.34" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
          <GradientStop Color="#1B1B20" Offset="0"/>
          <GradientStop Color="#0B0B0E" Offset="0.72"/>
          <GradientStop Color="#000000" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- the flowing ribbon, clipped to the ball -->
    <Canvas x:Name="Wave" Width="44" Height="44">
      <Canvas.Clip><EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/></Canvas.Clip>
    </Canvas>

    <!-- glossy highlight + faint rim -->
    <Ellipse>
      <Ellipse.Fill>
        <RadialGradientBrush GradientOrigin="0.36,0.2" Center="0.36,0.2" RadiusX="0.5" RadiusY="0.42">
          <GradientStop Color="#26FFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="0.62"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Stroke="#22FFFFFF" StrokeThickness="1"/>
  </Grid>
</UserControl>
